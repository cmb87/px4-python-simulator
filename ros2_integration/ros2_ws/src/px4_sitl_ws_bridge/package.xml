<?xml version="1.0"?>
<package format="3">
  <name>px4_sitl_ws_bridge</name>
  <version>0.1.0</version>
  <description>ROS2 to websocket bridge for px4_python_sitl simulator topics</description>
  <maintainer email="noreply@example.com">PX4 Python SITL Contributors</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>boost</depend>
  <depend>websocketpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
